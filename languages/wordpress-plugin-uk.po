msgid "Settings"
msgstr "Налаштування"

msgid "Images are bulk compressed by %s"
msgstr "Зображення масово стиснено за допомогою %s"

msgid "ImReso"
msgstr ""

msgid "Enable optimization"
msgstr "Увімкнути оптимізацію"

msgid "Output format"
msgstr "Формат виводу"

msgid "Quality"
msgstr "Якість"

msgid "Max dimension (px)"
msgstr "Максимальний розмір (px)"

msgid "Powered-by link"
msgstr "Посилання «Працює на»"

msgid "ImReso compresses and resizes your images right in your browser as you upload them — nothing is ever sent to an external server, so your photos stay private and your hosting does no work. It is free to use with no per-image limits or credits, and works in every modern browser, including Safari and iOS."
msgstr "ImReso стискає та змінює розмір ваших зображень безпосередньо у браузері під час завантаження — нічого не надсилається на зовнішній сервер, тож ваші фото залишаються приватними, а хостинг не виконує жодної роботи. Він безкоштовний, без обмеження кількості зображень чи кредитів, і працює в усіх сучасних браузерах, зокрема Safari та iOS."

msgid "Compress new uploads in the browser"
msgstr "Стискати нові завантаження у браузері"

msgid "Auto (best per image)"
msgstr "Авто (найкраще для кожного зображення)"

msgid "WebP"
msgstr ""

msgid "AVIF (smallest, slower)"
msgstr "AVIF (найменший, повільніше)"

msgid "JPEG"
msgstr ""

msgid "Auto picks AVIF/WebP/JPEG per image. WebP is the safest default for older browsers."
msgstr "«Авто» обирає AVIF/WebP/JPEG для кожного зображення. WebP — найбезпечніший варіант за замовчуванням для старих браузерів."

msgid "(1–100; lower = smaller files. 72 is a good default.)"
msgstr "(1–100; менше = менші файли. 72 — хороше значення за замовчуванням.)"

msgid "Also applied to the thumbnail sizes WordPress generates on the server."
msgstr "Також застосовується до розмірів мініатюр, які WordPress створює на сервері."

msgid "px (0 = no limit). Large photos are scaled down to this longest edge before compressing."
msgstr "px (0 = без обмежень). Великі фото зменшуються до цієї найдовшої сторони перед стисненням."

msgid "Show a small “Images are bulk compressed by BulkImageResizer” link in your site footer (off by default, purely optional)."
msgstr "Показувати невелике посилання «Зображення масово стиснено за допомогою BulkImageResizer» у підвалі сайту (вимкнено за замовчуванням, цілком необов’язково)."

msgid "ImReso: optimized %1$s → %2$s (saved %3$s%%)"
msgstr "ImReso: оптимізовано %1$s → %2$s (заощаджено %3$s%%)"

msgid "Max compress size (KB)"
msgstr "Максимальний розмір після стиснення (КБ)"

msgid "0 = off (use the Quality value below). Each image is expected to be compressed below this target size."
msgstr "0 = вимкнено (використовується значення «Якість» нижче). Очікується, що кожне зображення буде стиснено до розміру не більше цільового."

msgid "It uses almost the same engine as %s — the free online image resizer and compressor."
msgstr "Використовує майже той самий рушій, що й %s — безкоштовний онлайн-інструмент для зміни розміру та стиснення зображень."

msgid "Optimized"
msgstr "Оптимізовано"

msgid "Saved %1$s%% (%2$s → %3$s)"
msgstr "Заощаджено %1$s%% (%2$s → %3$s)"

msgid "%1$s images compressed and resized — %2$s space saved (%3$s%%)"
msgstr "%1$s зображень стиснено та змінено розмір — заощаджено %2$s (%3$s%%)"

msgid "Recent images compressed and resized"
msgstr "Нещодавно стиснені зображення зі зміненим розміром"

msgid "No images optimized yet."
msgstr "Ще немає оптимізованих зображень."

msgid "File"
msgstr "Файл"

msgid "Original"
msgstr "Оригінал"

msgid "Saved"
msgstr "Заощаджено"

msgid "Date"
msgstr "Дата"

