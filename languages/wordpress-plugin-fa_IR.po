msgid "Settings"
msgstr "تنظیمات"

msgid "Images are bulk compressed by %s"
msgstr "تصاویر به‌صورت دسته‌ای توسط %s فشرده شدند"

msgid "ImReso"
msgstr ""

msgid "Enable optimization"
msgstr "فعال‌سازی بهینه‌سازی"

msgid "Output format"
msgstr "قالب خروجی"

msgid "Quality"
msgstr "کیفیت"

msgid "Max dimension (px)"
msgstr "حداکثر ابعاد (px)"

msgid "Powered-by link"
msgstr "پیوند «طراحی‌شده با»"

msgid "ImReso compresses and resizes your images right in your browser as you upload them — nothing is ever sent to an external server, so your photos stay private and your hosting does no work. It is free to use with no per-image limits or credits, and works in every modern browser, including Safari and iOS."
msgstr "ImReso هنگام بارگذاری، تصاویر شما را مستقیماً در مرورگرتان فشرده و تغییر اندازه می‌دهد — هیچ چیز هرگز به سرور خارجی ارسال نمی‌شود، بنابراین عکس‌های شما خصوصی می‌مانند و میزبان شما هیچ کاری انجام نمی‌دهد. استفاده از آن رایگان است، بدون محدودیت در تعداد تصاویر یا اعتبار، و در همه مرورگرهای مدرن از جمله Safari و iOS کار می‌کند."

msgid "Compress new uploads in the browser"
msgstr "فشرده‌سازی بارگذاری‌های جدید در مرورگر"

msgid "Auto (best per image)"
msgstr "خودکار (بهترین برای هر تصویر)"

msgid "WebP"
msgstr ""

msgid "AVIF (smallest, slower)"
msgstr "AVIF (کوچک‌ترین، کندتر)"

msgid "JPEG"
msgstr ""

msgid "Auto picks AVIF/WebP/JPEG per image. WebP is the safest default for older browsers."
msgstr "«خودکار» برای هر تصویر AVIF/WebP/JPEG را انتخاب می‌کند. WebP امن‌ترین پیش‌فرض برای مرورگرهای قدیمی است."

msgid "(1–100; lower = smaller files. 72 is a good default.)"
msgstr "(1–100؛ کمتر = فایل‌های کوچک‌تر. 72 پیش‌فرض خوبی است.)"

msgid "Also applied to the thumbnail sizes WordPress generates on the server."
msgstr "همچنین برای اندازه‌های بندانگشتی که وردپرس روی سرور ایجاد می‌کند اعمال می‌شود."

msgid "px (0 = no limit). Large photos are scaled down to this longest edge before compressing."
msgstr "px (0 = بدون محدودیت). عکس‌های بزرگ پیش از فشرده‌سازی به این بلندترین ضلع کوچک می‌شوند."

msgid "Show a small “Images are bulk compressed by BulkImageResizer” link in your site footer (off by default, purely optional)."
msgstr "نمایش یک پیوند کوچک «تصاویر به‌صورت دسته‌ای توسط BulkImageResizer فشرده شدند» در پاورقی سایت شما (به‌طور پیش‌فرض خاموش، کاملاً اختیاری)."

msgid "ImReso: optimized %1$s → %2$s (saved %3$s%%)"
msgstr "ImReso: %1$s → %2$s بهینه شد (%3$s%% صرفه‌جویی)"

msgid "Max compress size (KB)"
msgstr "حداکثر اندازه فشرده‌سازی (KB)"

msgid "0 = off (use the Quality value below). Each image is expected to be compressed below this target size."
msgstr "0 = خاموش (از مقدار کیفیت در زیر استفاده می‌شود). انتظار می‌رود هر تصویر زیر این اندازه هدف فشرده شود."

msgid "It uses almost the same engine as %s — the free online image resizer and compressor."
msgstr "تقریباً از همان موتور %s استفاده می‌کند — ابزار آنلاین رایگان تغییر اندازه و فشرده‌سازی تصویر."

msgid "Optimized"
msgstr "بهینه‌شده"

msgid "Saved %1$s%% (%2$s → %3$s)"
msgstr "%1$s%% صرفه‌جویی (%2$s → %3$s)"

msgid "%1$s images compressed and resized — %2$s space saved (%3$s%%)"
msgstr "%1$s تصویر فشرده و تغییر اندازه داده شد — %2$s فضا ذخیره شد (%3$s%%)"

msgid "Recent images compressed and resized"
msgstr "تصاویر اخیراً فشرده و تغییر اندازه داده‌شده"

msgid "No images optimized yet."
msgstr "هنوز هیچ تصویری بهینه نشده است."

msgid "File"
msgstr "فایل"

msgid "Original"
msgstr "اصلی"

msgid "Saved"
msgstr "صرفه‌جویی"

msgid "Date"
msgstr "تاریخ"

