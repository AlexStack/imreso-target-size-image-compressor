msgid "Settings"
msgstr "הגדרות"

msgid "Images are bulk compressed by %s"
msgstr "תמונות נדחסו בכמות גדולה על ידי %s"

msgid "ImReso"
msgstr ""

msgid "Enable optimization"
msgstr "הפעלת אופטימיזציה"

msgid "Output format"
msgstr "פורמט פלט"

msgid "Quality"
msgstr "איכות"

msgid "Max dimension (px)"
msgstr "מימד מרבי (px)"

msgid "Powered-by link"
msgstr "קישור «מופעל על ידי»"

msgid "ImReso compresses and resizes your images right in your browser as you upload them — nothing is ever sent to an external server, so your photos stay private and your hosting does no work. It is free to use with no per-image limits or credits, and works in every modern browser, including Safari and iOS."
msgstr "ImReso דוחס ומשנה את גודל התמונות שלך ישירות בדפדפן בעת ההעלאה — שום דבר לא נשלח לעולם לשרת חיצוני, כך שהתמונות שלך נשארות פרטיות והאחסון שלך לא מבצע שום עבודה. השימוש חינמי, ללא הגבלה על מספר התמונות או קרדיטים, והוא פועל בכל הדפדפנים המודרניים, כולל Safari ו-iOS."

msgid "Compress new uploads in the browser"
msgstr "דחיסת העלאות חדשות בדפדפן"

msgid "Auto (best per image)"
msgstr "אוטומטי (הטוב ביותר לכל תמונה)"

msgid "WebP"
msgstr ""

msgid "AVIF (smallest, slower)"
msgstr "AVIF (הקטן ביותר, איטי יותר)"

msgid "JPEG"
msgstr ""

msgid "Auto picks AVIF/WebP/JPEG per image. WebP is the safest default for older browsers."
msgstr "«אוטומטי» בוחר AVIF/WebP/JPEG לכל תמונה. WebP הוא ברירת המחדל הבטוחה ביותר לדפדפנים ישנים."

msgid "(1–100; lower = smaller files. 72 is a good default.)"
msgstr "(1–100; נמוך יותר = קבצים קטנים יותר. 72 הוא ערך ברירת מחדל טוב.)"

msgid "Also applied to the thumbnail sizes WordPress generates on the server."
msgstr "חל גם על גדלי התמונות הממוזערות ש-WordPress יוצר בשרת."

msgid "px (0 = no limit). Large photos are scaled down to this longest edge before compressing."
msgstr "px (0 = ללא הגבלה). תמונות גדולות מוקטנות לצלע הארוכה הזו לפני הדחיסה."

msgid "Show a small “Images are bulk compressed by BulkImageResizer” link in your site footer (off by default, purely optional)."
msgstr "הצגת קישור קטן «תמונות נדחסו בכמות גדולה על ידי BulkImageResizer» בכותרת התחתונה של האתר שלך (כבוי כברירת מחדל, אופציונלי לחלוטין)."

msgid "ImReso: optimized %1$s → %2$s (saved %3$s%%)"
msgstr "ImReso: %1$s → %2$s עברו אופטימיזציה (חיסכון של %3$s%%)"

msgid "Max compress size (KB)"
msgstr "גודל דחיסה מרבי (KB)"

msgid "0 = off (use the Quality value below). Each image is expected to be compressed below this target size."
msgstr "0 = כבוי (משתמש בערך האיכות שלמטה). צפוי שכל תמונה תידחס מתחת לגודל היעד הזה."

msgid "It uses almost the same engine as %s — the free online image resizer and compressor."
msgstr "משתמש כמעט באותו מנוע כמו %s — הכלי המקוון החינמי לשינוי גודל ודחיסת תמונות."

msgid "Optimized"
msgstr "עברה אופטימיזציה"

msgid "Saved %1$s%% (%2$s → %3$s)"
msgstr "חיסכון של %1$s%% (%2$s → %3$s)"

msgid "%1$s images compressed and resized — %2$s space saved (%3$s%%)"
msgstr "%1$s תמונות נדחסו ושונו בגודלן — נחסכו %2$s (%3$s%%)"

msgid "Recent images compressed and resized"
msgstr "תמונות שנדחסו ושונו בגודלן לאחרונה"

msgid "No images optimized yet."
msgstr "עדיין לא בוצעה אופטימיזציה לתמונות."

msgid "File"
msgstr "קובץ"

msgid "Original"
msgstr "מקור"

msgid "Saved"
msgstr "נחסך"

msgid "Date"
msgstr "תאריך"

msgid "Free online image resizer"
msgstr ""

