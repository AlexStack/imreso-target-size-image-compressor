msgid "Settings"
msgstr "Настройки"

msgid "Images are bulk compressed by %s"
msgstr "Изображения массово сжаты с помощью %s"

msgid "ImReso"
msgstr ""

msgid "Enable optimization"
msgstr "Включить оптимизацию"

msgid "Output format"
msgstr "Формат вывода"

msgid "Quality"
msgstr "Качество"

msgid "Max dimension (px)"
msgstr "Максимальный размер (px)"

msgid "Powered-by link"
msgstr "Ссылка «Работает на»"

msgid "ImReso compresses and resizes your images right in your browser as you upload them — nothing is ever sent to an external server, so your photos stay private and your hosting does no work. It is free to use with no per-image limits or credits, and works in every modern browser, including Safari and iOS."
msgstr "ImReso сжимает и изменяет размер изображений прямо в браузере при загрузке — ничего не отправляется на внешний сервер, поэтому ваши фото остаются конфиденциальными, а хостинг не выполняет никакой работы. Использование бесплатное, без ограничения числа изображений и без кредитов, и работает во всех современных браузерах, включая Safari и iOS."

msgid "Compress new uploads in the browser"
msgstr "Сжимать новые загрузки в браузере"

msgid "Auto (best per image)"
msgstr "Авто (лучший для каждого изображения)"

msgid "WebP"
msgstr ""

msgid "AVIF (smallest, slower)"
msgstr "AVIF (самый маленький, медленнее)"

msgid "JPEG"
msgstr ""

msgid "Auto picks AVIF/WebP/JPEG per image. WebP is the safest default for older browsers."
msgstr "«Авто» выбирает AVIF/WebP/JPEG для каждого изображения. WebP — самый безопасный вариант по умолчанию для старых браузеров."

msgid "(1–100; lower = smaller files. 72 is a good default.)"
msgstr "(1–100; меньше = меньше файл. 72 — хорошее значение по умолчанию.)"

msgid "Also applied to the thumbnail sizes WordPress generates on the server."
msgstr "Также применяется к размерам миниатюр, которые WordPress создаёт на сервере."

msgid "px (0 = no limit). Large photos are scaled down to this longest edge before compressing."
msgstr "px (0 = без ограничений). Большие фотографии уменьшаются до этой наибольшей стороны перед сжатием."

msgid "Show a small “Images are bulk compressed by BulkImageResizer” link in your site footer (off by default, purely optional)."
msgstr "Показывать небольшую ссылку «Изображения массово сжаты с помощью BulkImageResizer» в подвале сайта (по умолчанию выключено, полностью по желанию)."

msgid "ImReso: optimized %1$s → %2$s (saved %3$s%%)"
msgstr "ImReso: оптимизировано %1$s → %2$s (экономия %3$s%%)"

msgid "Max compress size (KB)"
msgstr "Максимальный размер после сжатия (КБ)"

msgid "0 = off (use the Quality value below). Each image is expected to be compressed below this target size."
msgstr "0 = выключено (используется значение «Качество» ниже). Ожидается, что каждое изображение будет сжато до размера не больше целевого."

msgid "It uses almost the same engine as %s — the free online image resizer and compressor."
msgstr "Он использует почти тот же движок, что и %s — бесплатный онлайн-инструмент для изменения размера и сжатия изображений."

msgid "Optimized"
msgstr "Оптимизировано"

msgid "Saved %1$s%% (%2$s → %3$s)"
msgstr "Экономия %1$s%% (%2$s → %3$s)"

msgid "%1$s images compressed and resized — %2$s space saved (%3$s%%)"
msgstr "%1$s изображений сжато и с изменённым размером — сэкономлено %2$s (%3$s%%)"

msgid "Recent images compressed and resized"
msgstr "Недавно сжатые и изменённые изображения"

msgid "No images optimized yet."
msgstr "Пока нет оптимизированных изображений."

msgid "File"
msgstr "Файл"

msgid "Original"
msgstr "Оригинал"

msgid "Saved"
msgstr "Экономия"

msgid "Date"
msgstr "Дата"

